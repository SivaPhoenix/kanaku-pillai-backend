# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Must point at a replica set (transactions).
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kanaku_pillai?retryWrites=true&w=majority
MONGODB_URI=

# Optional comma-separated DNS server IPs for the SRV lookup of mongodb+srv:// URIs.
# Leave empty to use the system resolver; set it if you see "querySrv ECONNREFUSED".
DNS_SERVERS=

# Number of proxy hops in front of the API (0 when exposed directly, 1 behind one load balancer).
TRUST_PROXY=0
JSON_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Signs access tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated OAuth client IDs from Google Cloud (web, iOS, Android). Not secret. Required in production.
GOOGLE_CLIENT_IDS=

# Public web app origin. Email links (verify email, reset password) open pages here. https in production.
APP_WEB_URL=http://localhost:5173

# Email: "console" prints emails (with their links) to the API log instead of sending them. Production requires "smtp".
MAIL_TRANSPORT=console
# Sender shown to users. With Gmail SMTP this must be the Gmail account itself (or a verified "Send mail as" alias).
MAIL_FROM="Kanaku Pillai <no-reply.kanaku.pillai@gmail.com>"
# Gmail: smtp.gmail.com, port 465, secure=true. Port 587 needs SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# The Gmail address, and a 16-character Google app password (needs 2-Step Verification on); never the account password.
SMTP_USER=
SMTP_PASS=
